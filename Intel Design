    <!-- =====================================================
         JAVASCRIPT
    ===================================================== -->

    <script>

        /* =====================================================
           GET ELEMENTS
        ===================================================== */

        const timeline =
            document.querySelector(".timeline");

        const cards =
            document.querySelectorAll(".milestone");

        const nextButton =
            document.querySelector("#timelineNext");

        const previousButton =
            document.querySelector("#timelinePrev");


        /* =====================================================
           CALCULATE CARD WIDTH
        ===================================================== */

        function getScrollAmount() {

            if (!cards.length) {
                return 350;
            }

            const cardWidth =
                cards[0].getBoundingClientRect().width;

            return cardWidth + 35;
        }


        /* =====================================================
           NEXT BUTTON
        ===================================================== */

        nextButton.addEventListener(
            "click",
            () => {

                timeline.scrollBy({

                    left:
                        getScrollAmount(),

                    behavior:
                        "smooth"

                });

            }
        );


        /* =====================================================
           PREVIOUS BUTTON
        ===================================================== */

        previousButton.addEventListener(
            "click",
            () => {

                timeline.scrollBy({

                    left:
                        -getScrollAmount(),

                    behavior:
                        "smooth"

                });

            }
        );


        /* =====================================================
           ACTIVE CARD OBSERVER
        ===================================================== */

        const observer =
            new IntersectionObserver(

                (entries) => {

                    entries.forEach(
                        (entry) => {

                            if (
                                entry.isIntersecting
                            ) {

                                entry.target.classList.add(
                                    "active-milestone"
                                );

                            } else {

                                entry.target.classList.remove(
                                    "active-milestone"
                                );

                            }

                        }
                    );

                },

                {

                    root:
                        timeline,

                    threshold:
                        .65

                }

            );


        cards.forEach(
            card => observer.observe(card)
        );


        /* =====================================================
           RANDOM CARD TRANSITIONS
        ===================================================== */

        cards.forEach(
            (card, index) => {

                const randomRotation =
                    (
                        Math.random() * 1.4 - .7
                    ).toFixed(2);

                const randomOffset =
                    Math.floor(
                        Math.random() * 24
                    ) - 12;


                card.style.transform =
                    `
                    translateY(${randomOffset}px)
                    rotate(${randomRotation}deg)
                    `;


                /* Re-randomize when pointer leaves */

                card.addEventListener(
                    "mouseleave",
                    () => {

                        if (
                            window.innerWidth > 767
                        ) {

                            const newRotation =
                                (
                                    Math.random()
                                    * 1.4
                                    - .7
                                ).toFixed(2);

                            const newOffset =
                                Math.floor(
                                    Math.random()
                                    * 24
                                ) - 12;


                            card.style.transform =
                                `
                                translateY(${newOffset}px)
                                rotate(${newRotation}deg)
                                `;

                        }

                    }
                );


                /* Hover */

                card.addEventListener(
                    "mouseenter",
                    () => {

                        if (
                            window.innerWidth > 767
                        ) {

                            card.style.transform =
                                `
                                translateY(-18px)
                                rotate(-1deg)
                                scale(1.025)
                                `;

                        }

                    }
                );

            }
        );


        /* =====================================================
           KEYBOARD NAVIGATION
        ===================================================== */

        timeline.addEventListener(
            "keydown",
            (event) => {

                if (
                    event.key === "ArrowRight"
                ) {

                    timeline.scrollBy({

                        left:
                            getScrollAmount(),

                        behavior:
                            "smooth"

                    });

                }


                if (
                    event.key === "ArrowLeft"
                ) {

                    timeline.scrollBy({

                        left:
                            -getScrollAmount(),

                        behavior:
                            "smooth"

                    });

                }

            }
        );


        /* =====================================================
           DRAG-TO-SCROLL
        ===================================================== */

        let isDragging = false;

        let startX;

        let scrollStart;


        timeline.addEventListener(
            "mousedown",
            (event) => {

                isDragging = true;

                startX =
                    event.pageX -
                    timeline.offsetLeft;

                scrollStart =
                    timeline.scrollLeft;

                timeline.style.cursor =
                    "grabbing";

            }
        );


        timeline.addEventListener(
            "mouseleave",
            () => {

                isDragging = false;

                timeline.style.cursor =
                    "grab";

            }
        );


        timeline.addEventListener(
            "mouseup",
            () => {

                isDragging = false;

                timeline.style.cursor =
                    "grab";

            }
        );


        timeline.addEventListener(
            "mousemove",
            (event) => {

                if (!isDragging) {
                    return;
                }


                event.preventDefault();


                const x =
                    event.pageX -
                    timeline.offsetLeft;


                const distance =
                    x - startX;


                timeline.scrollLeft =
                    scrollStart - distance;

            }
        );


        /* =====================================================
           INITIAL CURSOR
        ===================================================== */

        timeline.style.cursor =
            "grab";


    </script>


